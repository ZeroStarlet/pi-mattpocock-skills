{
  "name": "mattpocock-skills",
  "version": "1.2.3",
  "private": true,
  "description": "Matt Pocock's agent skills for real engineering",
  "repository": {
    "type": "git",
    "url": "https://github.com/ZeroStarlet/pi-mattpocock-skills"
  },
  "license": "MIT",
  "keywords": [
    "pi-package",
    "engineering",
    "skills",
    "tdd",
    "code-review",
    "productivity"
  ],
  "pi": {
    "extensions": [
      "./extensions/pi-compat.ts"
    ],
    "skills": [
      "./skills/engineering",
      "./skills/productivity"
    ]
  },
  "scripts": {
    "changeset": "changeset",
    "version": "changeset version && node scripts/sync-plugin-version.mjs",
    "check-plugin-version": "node scripts/sync-plugin-version.mjs --check",
    "check-pi-package": "node scripts/check-pi-package.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.30.0"
  },
  "packageManager": "npm@10.9.4"
}
